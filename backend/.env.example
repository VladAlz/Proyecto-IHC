# ==========================================
# Servidor
# ==========================================
PORT=3000
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Base de datos
# ==========================================
# sqljs  -> SQLite embebido en backend/data/usability.sqlite (por defecto, sin instalar nada)
# postgres -> PostgreSQL (levántalo con `npm run db:up` desde la raíz)
DB_TYPE=sqljs
# DB_FILE=./data/usability.sqlite

# Solo si DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DATABASE=usability_db

# Siembra datos del Sprint 1 + demo cuando la base está vacía
SEED_ON_START=true
# Permite POST /api/admin/reset (botón "Restaurar datos")
ALLOW_RESET=true

# ==========================================
# Asistente IA (capas gratuitas)
# ==========================================
# Proveedor principal: gemini | groq | openrouter | local
AI_PROVIDER=gemini
# Respaldo, en orden, si el principal falla o agota su cuota
AI_FALLBACK_PROVIDERS=groq,openrouter
AI_TIMEOUT_MS=30000

# Google AI Studio (gratis, sin tarjeta): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (gratis): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (modelos :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Sin ninguna key, el asistente funciona con el motor heurístico local.
